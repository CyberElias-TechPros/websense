# Client environment (optional — defaults work for dev).
# In production the client is served by the backend (or nginx) and uses
# relative /api and /socket.io paths (same origin).

# Vite dev server proxies /api + /socket.io to the backend automatically.
# Set VITE_API_URL if the dashboard is served from a different origin
# than the API (e.g. remote backend at http://192.168.1.10:3001).
VITE_API_URL=/api
VITE_SOCKET_URL=
