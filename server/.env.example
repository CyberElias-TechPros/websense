# ============================================================================
# .env.example — copy to .env and adjust. All values optional (defaults shown).
# ============================================================================

# --- Server ---
PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Proxy credentials (defaults match the README-provided pool) ---
PROXY_USERNAME=hmxpvtyv
PROXY_PASSWORD=s56i3b0mmjwv

# --- Engine behaviour ---
MIN_INTERVAL_MS=5000
MAX_INTERVAL_MS=30000
CONCURRENCY=3
REQUEST_TIMEOUT_MS=3000
RETRY_ATTEMPTS=2
RETRY_BACKOFF_BASE_MS=500
VISIT_MODE=http          # http | browser | mixed
AUTO_START=0            # 1 = start engine on server boot
DEMO_MODE=0             # 1 = simulate visits without network (testing/demo)

# --- Health checking ---
HEALTH_CHECK_INTERVAL_MS=60000
HEALTH_CHECK_TIMEOUT_MS=10000
HEALTH_CHECK_TARGET=https://api.ipify.org?format=json
CIRCUIT_OPEN_AFTER=5
CIRCUIT_COOLDOWN_MS=60000

# --- Database ---
DB_PATH=data/visits.db
DB_WAL=1
DB_CLEANUP_DAYS=30

# --- Logging ---
LOG_LEVEL=info
