# ============================================================================
# .env.example — copy to .env and adjust. All values optional (defaults shown).
# ============================================================================

# --- Server ---
PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Proxy credentials (REQUIRED for the paid Webshare pool — env only,
# never hardcoded in source. Rotate them if they were ever committed.) ---
PROXY_USERNAME=your-webshare-username
PROXY_PASSWORD=your-webshare-password

# --- Engine behaviour ---
MIN_INTERVAL_MS=5000
MAX_INTERVAL_MS=30000
CONCURRENCY=3
REQUEST_TIMEOUT_MS=3000
RETRY_ATTEMPTS=2
RETRY_BACKOFF_BASE_MS=500
VISIT_MODE=http          # http | browser | mixed
AUTO_START=0            # 1 = start engine on server boot
DEMO_MODE=0             # 1 = simulate visits without network (testing/demo)

# --- Health checking ---
HEALTH_CHECK_INTERVAL_MS=60000
HEALTH_CHECK_TIMEOUT_MS=10000
HEALTH_CHECK_TARGET=https://api.ipify.org?format=json
CIRCUIT_OPEN_AFTER=5
CIRCUIT_COOLDOWN_MS=60000

# --- Database ---
DB_PATH=data/visits.db
DB_WAL=1
DB_CLEANUP_DAYS=30

# --- Logging ---
LOG_LEVEL=info

# --- Browser mode ---
HEADLESS=1              # 0 = show the browser window while visiting

# --- Free proxy aggregation (GitHub repos: proxifly, TheSpeedX, monosans, …) ---
# Merged into the pool next to the paid Webshare proxies (which are never
# touched by free-source refreshes). 1 = on (default).
FREE_PROXIES=1
FREE_PROXY_MAX=5000                 # cap so rotation stays workable
FREE_PROXY_REFRESH_HOURS=6          # auto-refresh interval
FREE_PROXY_TIMEOUT_MS=45000
FREE_PROXY_PER_SOURCE_CAP=2000

# --- AI behavior director (how each visit behaves like a human) ---
# AI_PROVIDER: auto | omniroute | ollama | openai | off   (auto = omniroute → ollama → heuristic)
# OmniRoute = open-source local AI gateway, OpenAI-compatible, default :20128
AI_PROVIDER=auto
OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=openai/gpt-4o-mini
OMNIROUTE_API_KEY=                  # optional, if your gateway requires auth
# Generic OpenAI-compatible endpoint (OpenRouter, vLLM, LM Studio, …) — used
# when AI_PROVIDER=openai or as OMNIROUTE_URL fallback:
# OPENAI_COMPAT_URL / OPENAI_API_KEY / OPENAI_MODEL
AI_TIMEOUT_MS=8000                  # LLM calls never block a visit longer than this
AI_BEHAVIOR=1                       # 0 = disable director (heuristic personas still used)

# --- Analytics / consent (affects whether AdSense renders on visited pages) ---
ANALYTICS_ENABLED=1
ANALYTICS_CONSENT=advanced          # none | basic | advanced — 'advanced' = "Accept all"

# --- Geo-match: prefer a proxy whose country matches the fingerprint locale ---
GEO_MATCH_PROXIES=1                 # 0 = disable profile↔proxy country matching

# --- Free-proxy archiving: free proxies failing N times in a row are archived ---
# (kept in pool, out of rotation; re-activated if a fresh list shows them again;
#  paid Webshare proxies are NEVER archived). 0 = off.
FREE_PROXY_ARCHIVE_AFTER_FAILURES=5

# --- Per-target-domain rules (opt-outs, rate limits, robots.txt respect) ---
DOMAIN_RULES_ENABLED=1
RESPECT_ROBOTS=1                    # honor robots.txt Disallow for visited paths
DOMAIN_MIN_INTERVAL_MS=60000        # min gap between visits to the same domain
DOMAIN_MAX_VISITS_PER_HOUR=20       # per-domain hourly cap
DOMAIN_OPT_OUTS=example-never-visit.com   # comma-separated domains to never visit

# --- Observability: metrics + alerts (/api/metrics, /api/alerts) ---
OBSERVABILITY=1
ALERT_ERROR_RATE=0.30               # visit error-rate alert threshold
ALERT_FALLBACK_RATE=0.8             # heuristic-fallback-rate alert (LLM down?)
ALERT_ZERO_REFRESHES=2              # consecutive empty free-refreshes before alert
ALERT_DETECTION_SIGNALS=8           # detection signals in 5 min before alert

# --- API token auth (optional but recommended if the dashboard is exposed) ---
# When set, every /api request must carry "Authorization: Bearer <token>"
# (or ?token=<token>) and socket.io connections must send auth: { token }.
# The client reads VITE_API_TOKEN or localStorage websense_api_token.
API_TOKEN=

# --- Batched background health checks (pool sweeps are rotating windows) ---
HEALTH_CHECK_BATCH_SIZE=100         # proxies probed per health-check interval
HEALTH_CHECK_BATCH_CONCURRENCY=25   # concurrent probes within a batch

# --- Data retention ---
# DB_CLEANUP_DAYS already set above: visits older than this are purged daily.
